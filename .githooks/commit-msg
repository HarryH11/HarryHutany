#!/bin/sh
# Strip AI co-author / attribution trailers from every commit message.
# Enable once per clone:  git config core.hooksPath .githooks
msg_file="$1"
tmp="$(mktemp)"
grep -v -i -E '^(Co-Authored-By:.*(Claude|anthropic)|Claude-Session:|.*Generated with \[?Claude)' "$msg_file" > "$tmp"
sed -e ':a' -e '/^\n*$/{$d;N;ba' -e '}' "$tmp" > "$msg_file"
rm -f "$tmp"
exit 0
